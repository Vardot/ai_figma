{
  "packageManager": "yarn@4.9.3",
  "name": "ai_figma",
  "private": true,
  "description": "Varbase E2E (Playwright + Cucumber) BDD suite for the AI Figma Drupal module: drives a freshly installed site to prove the admin settings page, the AI configuration and the status report load with no PHP errors.",
  "license": "GPL-2.0",
  "engines": {
    "node": ">= 22.0",
    "yarn": ">= 1.6"
  },
  "keywords": [
    "Drupal",
    "Figma",
    "Canvas",
    "AI"
  ],
  "author": "Rajab Natshah",
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js tests/step-definitions",
    "generate-reports": "generate-reports"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.0.1",
    "@cucumber/pretty-formatter": "1.0.0",
    "@vardot/varbase-e2e": "^2.0.4",
    "eslint": "~8",
    "eslint-config-prettier": "~8"
  },
  "resolutions": {
    "@cucumber/pretty-formatter": "1.0.0",
    "@cucumber/cucumber": "10.0.1"
  }
}
