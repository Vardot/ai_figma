{
  "css": {
    "modal": ".ui-dialog, [role=\"dialog\"], .dialog-off-canvas-main-canvas",
    "main nav": "#toolbar-bar, .toolbar-bar, .toolbar-menu, #toolbar-item-administration-tray",
    "main nav item": ".toolbar-menu a",
    "page title": "h1.page-title, .region-page-title h1, .page-header h1",
    "drupal page heading": "h1",
    "save button": "#edit-submit, .button--primary, input[value=\"Save\"]",
    "delete button": ".button--danger, a.button[href*='delete']",
    "primary button": ".button--primary",
    "notice success": ".messages--status, .messages[role=\"contentinfo\"]",
    "notice error": ".messages--error, .messages[role=\"alert\"]",
    "notice warning": ".messages--warning",
    "drupal admin status messages": ".messages--status",
    "drupal admin error messages": ".messages--error",
    "drupal admin warning messages": ".messages--warning",
    "breadcrumb": ".breadcrumb, nav[role=\"navigation\"].breadcrumb",
    "local tasks": ".tabs--primary, [data-drupal-nav-tabs]",
    "local task item": ".tabs--primary li, .tabs__tab",
    "local actions": ".local-actions, .action-links",
    "content area": ".layout-container main, main[role=\"main\"], .page-content",
    "form": ".layout-container form, main form",
    "form item": ".form-item",
    "form input": ".form-element, input.form-text, input.form-email",
    "form select": ".form-element--type-select, select.form-select",
    "form textarea": "textarea.form-textarea",
    "form actions": ".form-actions",
    "details": ".claro-details, details",
    "details summary": ".claro-details__summary, details > summary",
    "data table": "table.views-table, table.responsive-enabled",
    "table header": "thead tr",
    "table row": "tbody tr",
    "table first row": "tbody tr:first-child",
    "status report": ".system-status-report",
    "permissions table": "#permissions, table#permissions",
    "user menu": ".toolbar-tab--toolbar-item-user",
    "search input": "input[data-drupal-selector*='search'], input.form-search"
  },
  "xpath": {
    "page main heading": "//h1[contains(@class,'page-title')]",
    "first table row": "//table//tbody/tr[1]",
    "messages block": "//div[contains(@class,'messages')]"
  }
}
